PORT=5000
NODE_ENV=development

# MongoDB (use the SAME database as the client's Better Auth)
MONGODB_URI=
MONGODB_DB=salonbook

# URL of the Next.js client (also where Better Auth lives). No trailing slash.
CLIENT_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ImgBB
IMGBB_API_KEY=
